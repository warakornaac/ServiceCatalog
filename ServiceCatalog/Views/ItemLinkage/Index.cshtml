            dataType: 'json',
            beforeSend: function () {
                Swal.fire({
                    title: 'Searching...',
                    text: 'Please wait while we processing on the product.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            },
            success: function (data) {
                Swal.close();

                if (data.result == 'Y') {
                    Swal.fire({
                        title: "Delete linkage success!",
