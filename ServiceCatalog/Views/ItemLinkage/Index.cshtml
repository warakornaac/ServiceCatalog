                    }).then((result) => {
                        if (result.isConfirmed) {
                            GetLinkageData(stkcod);
                            searchVehicle();
                        }
                    });
                }
                else {
                    Swal.fire({
                        title: "Error?",
                        text: data.message,
                        icon: "error"
                    });
                }
            }
        });//end ajax
    }
});
