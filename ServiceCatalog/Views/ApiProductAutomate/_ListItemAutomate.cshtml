                        } else {
                            Swal.fire({
                                icon: 'error',
                                //title: res.msg,
                                html: 'Error not saved',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Close',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
                    },
                    error: function (ex) {
                        //notify(ex, 'danger');
                    },
                    complete: function (res) {
                        LoadingHide();
                    }
                }).fail(function (error) {
