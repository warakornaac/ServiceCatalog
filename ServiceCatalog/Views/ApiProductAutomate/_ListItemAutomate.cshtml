@using ServiceCatalog.Models;
<div class="row" id="tasks-container">
    @{
        var productTruList = ViewBag.listSearchProductTru as List<StoredSearchProductTruByStatusModel>;
        string txtStatus = string.Empty;
        string colorStatus = string.Empty;
        string iconBtnStatus = string.Empty;
        string nameStkcodeTask = "";
        string nameBrandTask = "";
        string disabledButton = "";

        if (productTruList != null && productTruList.Count > 0)
        {
            foreach (var rowProductTru in productTruList)
            {
                nameStkcodeTask = "stkcode_task_" + rowProductTru.Stkcode;
                nameBrandTask = "brand_task_" + rowProductTru.Stkcode;
                <input type="hidden" name="listArrayStkcode[]" class="listArrayStkcode" value="@rowProductTru.Stkcode" />
                <div class="col-xxl-2 col-md-3 task-card" id="task_card_@rowProductTru.Stkcode">
                    <div class="card custom-card task-pending-card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between" style="margin-bottom: -20px;">
                                <div>
                                    @{
                                        string fullTextStkdesc = string.IsNullOrWhiteSpace(rowProductTru.Stkdesc) ? "-" : rowProductTru.Stkdesc;
                                        string shortTextStkdesc = fullTextStkdesc.Length > 20 ? fullTextStkdesc.Substring(0, 20) : fullTextStkdesc;
                                    }
                                    <a href="javascript:void(0);" class="fs-12 fw-semibold mb-3 d-flex align-items-center">@shortTextStkdesc</a>
                                    <p class="text-danger fs-12 mb-3"> (@rowProductTru.Stkcode) @*<span class="badge bg-danger">pending</span>*@</p>
                                    <p class="text-success fs-11"> @rowProductTru.BrandName </p>

                                    <input type="hidden" id="@nameStkcodeTask" name="@nameStkcodeTask" value="@rowProductTru.Stkcode" class="form-control">
                                    <input type="hidden" id="@nameBrandTask" name="@nameBrandTask" value="@rowProductTru.BrandId" class="form-control">

                                    @*<span class="avatar-list-stacked ms-1">
                                            test
                                        </span>
                                        <span class="me-2"><button aria-label="button" type="button" class="btn btn-sm btn-icon btn-wave btn-secondary-light waves-effect waves-light" data-bs-toggle="modal" data-bs-target="#addpromodal1"><i class="ri-add-fill"></i></button></span>
                                    *@
                                    <div class="modal fade" id="addpromodal1" tabindex="-1" aria-labelledby="AddModalLabel1" aria-hidden="true">
                                        <div class="modal-dialog ">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h6 class="modal-title" id="AddModalLabel1">Edit Assigne</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                            aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <div class="mb-3">
                                                                <label class="col-form-label">Assigne To:</label>
                                                                <input type="text" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                        Save
                                                    </button>
                                                    <button type="button" class="btn btn-primary">Cancel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    @{
                                        if (rowProductTru.ApiStatus == "Y")
                                        {
                                            txtStatus = "Complete";
                                            colorStatus = "success";
                                            iconBtnStatus = "<i class='ri-eye-line'></i>";
                                            disabledButton = "";
                                        }
                                        else if (rowProductTru.ApiStatus == "D")
                                        {
                                            txtStatus = "In Progress";
                                            colorStatus = "warning";
                                            iconBtnStatus = "<i class='spinner-grow spinner-grow-sm align-middle' aria-hidden='true'></i>";
                                            disabledButton = "disabled";
                                        }
                                        else
                                        {
                                            txtStatus = "Pending";
                                            colorStatus = "warning";
                                            iconBtnStatus = "<i class='ri-lock-fill'></i>";
                                            disabledButton = "disabled";
                                        }
                                    }
                                    @*<i class="ri-lock-fill"></i>*@
                                    <div class="btn-list">
                                        <button class="btn btn-sm btn-primary-light" type="button" onclick="getItemProductDeatil('@rowProductTru.Stkcode')" id="task_btn_status_@rowProductTru.Stkcode" @disabledButton>
                                            <span>@Html.Raw(iconBtnStatus)</span>
                                        </button>
                                    </div>
                                    <span class="footer-badge badge bg-@colorStatus-transparent d-block">@txtStatus</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12">
                <ul class="list-unstyled mb-0 notification-container">
                    <li>
                        <div class="card mb-3 bg-warning-transparent border-warning">
                            <div class="d-flex p-3 border-bottom-0">
                                <div class="d-sm-flex">
                                    <div class="">
                                        <svg class="me-4  bg-warning  alt-notify" xmlns="http://www.w3.org/2000/svg" enable-background="new 0 0 24 24" viewBox="0 0 24 24"><path fill="#ffe1a7" d="M18,13.18463V10c0-3.31372-2.68628-6-6-6s-6,2.68628-6,6v3.18463C4.83832,13.59863,4.00146,14.69641,4,16v2c0,0.00037,0,0.00073,0,0.00116C4.00031,18.5531,4.44806,19.00031,5,19h14c0.00037,0,0.00073,0,0.00116,0C19.5531,18.99969,20.00031,18.55194,20,18v-2C19.99854,14.69641,19.16168,13.59863,18,13.18463z"></path><path fill="#ffe1a7" d="M8.14233 19c.4472 1.72119 1.99689 2.99817 3.85767 3 1.86078-.00183 3.41046-1.27881 3.85767-3H8.14233zM12 4c.34149 0 .67413.03516 1 .08997V3c0-.55231-.44769-1-1-1s-1 .44769-1 1v1.08997C11.32587 4.03516 11.65851 4 12 4z"></path></svg>
                                    </div> <div class="mt-2 text-start"> <span class="fs-14 fw-semibold">No Data...</span></div>
                                </div> <a href="javascript:void(0);" class="ms-auto"> <i class="fe fe-x text-warning border border-warning rounded-2 p-1 fs-12"></i> </a>
                            </div>
                        </div>
                    </li>
                    @*<li> <div class="card bg-success-transparent mb-3 border-success"> <div class="d-flex p-3 border-bottom-0"> <div class="d-sm-flex"> <div class=""> <svg class="me-4  bg-success  alt-notify" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="#82d5be" d="m20.34 9.32-13.99-7a3 3 0 0 0-4.08 3.9L4.41 11l.26.59a1.06 1.06 0 0 1 0 .82l-.26.59-2.14 4.78a2.954 2.954 0 0 0 .67 3.38A2.966 2.966 0 0 0 5 22a3.141 3.141 0 0 0 1.35-.32l13.99-7a2.993 2.993 0 0 0 0-5.36Z"></path><path fill="#abffe8" d="M14.46 12a.997.997 0 0 1-1 1H4.41l.26-.59a1.06 1.06 0 0 0 0-.82L4.41 11h9.05a.997.997 0 0 1 1 1Z"></path></svg> </div> <div class="mt-0 text-start"> <span class="fs-14 fw-semibold">New Notification</span> <p class="fs-13 text-muted mb-0">Warning! Better check yourself, you're not looking too goodWarning! Better check yourself, <a href="javascript:void(0);" class="ms-3 text-success">Read more</a></p></div> </div> <a href="javascript:void(0);" class="ms-auto"> <i class="fe fe-x text-success border border-success rounded-2 p-1 fs-12"></i> </a> </div> </div> </li>*@
                </ul>
            </div>
        }
    }
</div>

<!-- Modal -->
<div class="modal fade" id="itemProductDeatilModal" aria-labelledby="itemProductDeatilModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-2">
                <div class="col-sm-10 col-md-10">
                    <h4 class="modal-title" id="ModalLabel">รายละเอียด</h4>
                </div>
                <div class="col-sm-2 col-md-2 text-right">
                    <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
            <div class="modal-body">
                <!-- Dynamic content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> ปิด
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script defer>
    //get detail modal
    function getItemProductDeatils(Stkcode) {
        $.ajax({
            url: '@Url.Action("getItemProductDeatil", "ItemProduct")',
            type: 'POST',
            dataType: 'HTML',
            data: {
                Stkcode: Stkcode
            },
            beforeSend: function () {
                //LoadingShow();
                $('#itemProductDeatilModal').find('.modal-body').html("");
            },
            success: function (data) {
                $('#itemProductDeatilModal').find('.modal-body').html(data);
                $('#itemProductDeatilModal').modal('show');
            },
            complete: function () {
                //LoadingHide();
            },
            error: function (er) {
                Swal.fire({
                    icon: 'error',
                    html: '<p>getItemProductDeatil :</p><p>' + er.error + '</p>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด กรุณาแจ้งผู้ดูแลระบบ (' + error.status + ')',
                html: '<p>getItemProductDeatil :</p><p>' + error.responseText + '</p>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
    //reload call
    async function reloadTaskCallApi(rowNumber) {
        //const runTaskCallApi = await runTaskCallApi();
        GetProductApiAutomateCount();  //count item
        GetListItemAutomateByStatus("", "", "", rowNumber, "pending"); //show data pending
        setTimeout(function () {
            //call api
            ajaxTaskCallApi();
            //reload number
            //$('#sumItemAll').html("<div class='spinner-border text-secondary'></div>");
            //$('#sumItemAllSuccess').html("<div class='spinner-border text-secondary'></div>");
            //$('#sumItemCurrentAll').html("<div class='spinner-border text-secondary'></div>");
            //$('#sumItemCurrentAllSuccess').html("<div class='spinner-border text-secondary'></div>");
            //$('#sumItemCurrentTaskPendding').html("-");
            //$('#sumItemCurrentTaskProcess').html("-");
            //$('#sumItemCurrentTaskComplete').html("-");
            console.log("runTaskCallApi");
        }, 1000); //1000 = 1 วินาที
    }
    //random number
    function getRandomInt() {
        var txtNumberStart = 0;
        var txtNumberEnd = 0;
        txtNumberStart = $("#resNumberStart").val();
        txtNumberEnd = $("#resNnumberEnd").val();
        console.log("txtNumberStart = " + txtNumberStart);
        console.log("txtNumberEnd = " + txtNumberEnd);
        return Math.floor(Math.random() * (parseInt(txtNumberEnd) - parseInt(txtNumberStart) + 1)) + parseInt(txtNumberStart);
    }
    //Para callApiStop false = run, true = stop
    let callApiStop = false;
    //stop call api
    function stopTaskCallApi() {
        Swal.fire({
            title: 'ต้องการหยุด Task',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00a65a',
            cancelButtonColor: '#d33',
            confirmButtonText: '<i class="fa fa-check"></i> Yes',
            cancelButtonText: '<i class="fa fa-times"></i> No',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then((result) => {
            if (result.value) {
                callApiStop = true;
                console.log("stopTaskCallApi");
                console.log("callApiStop = " + callApiStop);
                $("#btnStopTask").prop("disabled", true);
                $("#btnRunTask").prop("disabled", false);
            }
        });
    }
    //run call api
    async function runTaskCallApi() {
        var request = [];
        var countRequestStkcode = 0;
        var countSaveStkcode = 0;
        var resNumberRandom;
        // pop up confirm
        var textMsgRun = '<form id="form-add-pack" style="text-align: left;">';
        textMsgRun += '<label class="text-primary"> <div class="input-group mb-3">' +
                                        '<span class="input-group-text">Start</span>' +
                                        '<input type="number" name="numberStart" id="numberStart" value="" class="form-control" placeholder="NumberStart" aria-label="Username">' +
                                        '<span class="input-group-text">To</span>' +
                                        '<input type="number" name="numberEnd" id="numberEnd" class="form-control" placeholder="NumberEnd" aria-label="Server">' +
                                    '</div> </label>';
        textMsgRun += '</form>';
        const result = await Swal.fire({
            title: 'ต้องการรัน Task',
            html: textMsgRun,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00a65a',
            cancelButtonColor: '#d33',
            confirmButtonText: '<i class="fa fa-check"></i> Yes',
            cancelButtonText: '<i class="fa fa-times"></i> No',
            allowOutsideClick: false,
            focusConfirm: false,
            preConfirm: () => {
                const numberStart = document.getElementById('numberStart').value.trim();
                const numberEnd = document.getElementById('numberEnd').value.trim();
                console.log("numberStart = " + numberStart);
                console.log("numberEnd = " + numberEnd);
                if (!numberStart || !numberEnd) {
                    Swal.showValidationMessage('กรุณากรอก Number Start และ Number End');
                    return false;
                }
                const numStart = parseInt(numberStart);
                const numEnd = parseInt(numberEnd);
                if (isNaN(numStart) || isNaN(numEnd)) {
                    Swal.showValidationMessage('กรุณากรอกตัวเลขที่ถูกต้อง');
                    return false;
                }
                if (numStart > numEnd) {
                    Swal.showValidationMessage('Number Start ต้องน้อยกว่าหรือเท่ากับ Number End');
                    return false;
                }

                $("#resNumberStart").val(numberStart);
                $("#resNnumberEnd").val(numberEnd);
                resNumberRandom = getRandomInt();
                $("#resNumberRandom").val(resNumberRandom);

                if (resNumberRandom > 0) {
                    $('#txtResNumberRandom').text(Number(resNumberRandom).toLocaleString());
                    reloadTaskCallApi(resNumberRandom);
                }

                return { numberStart: numStart, numberEnd: numEnd };
                //return false;
            }
        });
        // btn no
        if (!result.value) {
            callApiStop = true;
            GetProductApiAutomateCount();  // reload
        }

    }
    //ajax call api
    async function ajaxTaskCallApi() {
        var request = [];
        var countRequestStkcode = 0;
        var countSaveStkcode = 0;
        var resNumberRandom;
        callApiStop = false; // reset
        if (!callApiStop) {
            //เปิดปุ่ม stop
            $("#btnStopTask").prop("disabled", false);
            $("#btnRunTask").prop("disabled", true);
            //get item by tab pending
            $('#pending .listArrayStkcode').each(function () {
                var Stkcode = $(this).val();
                if (Stkcode != null && Stkcode !== "") {
                    ++countRequestStkcode;
                    $("[id='task_btn_status_" + Stkcode + "'] span").html('<i class="spinner-grow spinner-grow-sm align-middle" aria-hidden="true"></i>');
                    $("[id='task_btn_status_" + Stkcode + "']").attr('disabled', 'disabled');
                    var details = {
                        PartNo: $("input[name='stkcode_task_" + Stkcode + "']").val(),
                        BrandId: parseInt($("input[name='brand_task_" + Stkcode + "']").val())
                    };
                    request.push(details);
                }
            });
            //console.log("countRequestStkcode = " + countRequestStkcode);
            if (request.length === 0) {
                await Swal.fire({
                    icon: 'error',
                    html: 'ไม่พบข้อมูลของของ Item',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Close',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
                return;
            }
        }
        //sleep
        const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));
        //delay
        for (const detail of request) {
            if (callApiStop) {
                console.warn("Stopped by user.");
                Swal.fire({
                    icon: 'info',
                    title: 'หยุดการรัน Task แล้ว',
                   // text: 'The API calls were stopped by the user.',
                    confirmButtonColor: '#3085d6'
                });
                break;
            }
            try {
                const result = await $.ajax({
                    type: 'POST',
                    url: '@Url.Action("RunTaskSaveProductApiToDb", "ApiProduct")',
                    data: JSON.stringify(detail),
                    contentType: "application/json; charset=utf-8"
                });
                //console.log(result);
                if (result.resultPartNo != null && result.resultBrandId != null) {
                    ++countSaveStkcode;

                    if (result.status === "success") {
                        $("[id='task_btn_status_" + result.resultPartNo + "'] span").html('<i class="ri-download-2-fill ri-1x"></i>');
                    }
                }
                //call ตามจำนวนสำเร็จ
                if (countSaveStkcode === countRequestStkcode) {
                    console.log("SaveSuccess");
                    resNumberRandom = getRandomInt();
                    //เริ่ม ดึง Call ใหม่
                    $('#txtResNumberRandom').text(Number(resNumberRandom).toLocaleString());
                    reloadTaskCallApi(resNumberRandom);
                }
            } catch (error) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Error not saved',
                    html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>runTaskCallApi<br><br>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false,
                });
            }
            // 1000 = 1 วินาที
            await sleep(500);
        }
    }
</script>
