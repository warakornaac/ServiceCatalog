    //run task
    async function runTaskCallApi(){
        var request = [];
        var countRequestStkcode = 0;
        var countSaveStkcode = 0;
        Swal.fire({
            title: 'Do you confirm run',
           // html: html,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00a65a',
            cancelButtonColor: '#d33',
            confirmButtonText: '<i class="fa fa-check"></i> Yes',
            cancelButtonText: '<i class="fa fa-times"></i> No',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then((result) => {
            if (result.value) {
                $('#pending .listArrayStkcode').each(function () {
                    ++countRequestStkcode;
                    var Stkcode;
                    Stkcode = $(this).val();
                    if (Stkcode != null || Stkcode != "") {
                        //icon in process
                        $("[id='task_btn_status_" + Stkcode + "'] span").html('<i class="spinner-grow spinner-grow-sm align-middle" aria-hidden="true"></i>');
                        $("[id='task_btn_status_" + Stkcode + "']").attr('disabled', 'disabled');
                        var details = {
                            PartNo: $("input[name='stkcode_task_" + Stkcode + "']").val(),
                            BrandId: parseInt($("input[name='brand_task_" + Stkcode + "']").val())
                        }
                    request.push(details);
                    }
                });
                console.log("countRequestStkcode = " + countRequestStkcode);
                //console.log(JSON.stringify(request));
                //return false;
                if (request != null) {  //พบ List stkcode
                    request.forEach(function (detail) {
                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("RunTaskSaveProductApiToDb", "ApiProduct")',
                            data: JSON.stringify(detail),
                            contentType: "application/json; charset=utf-8",
                            beforeSend: function () {
                                //LoadingShow();
                            },
                            success: function (result) {
                                console.log(result);
                                //return false;
                                if (result.resultPartNo != null && result.resultBrandId != null) {
                                    ++countSaveStkcode;
                                    if (result.status == "success") { //save success
                                        $("[id='task_btn_status_" + result.resultPartNo + "'] span").html('<i class="ri-download-2-fill ri-1x"></i>');
                          
                                    } else { //save fail
                                    }
                                }
                                console.log("countSaveStkcode = " + countSaveStkcode);
                                if (countSaveStkcode == countRequestStkcode) {
                                    console.log("SaveSuccess");
                                    //$('.listArrayStkcode').val('');
                                    //request = [];
                                    reloadTaskCallApi();
                                }

                            }
                        }).fail(function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error not saved',
                                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>runTaskCallApi<br><br>',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        });
                    });
                } else { //ไม่พบ List stkcode
                    Swal.fire({
                        icon: 'error',
                        html: 'ไม่พบข้อมูลของของ Item',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'Close',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
                //return false;
                @*$.ajax({
                    type: 'POST',
                    cache: false,
                    url: '@Url.Action("RunTaskSaveProductApiToDb", "ApiProduct")',
                    data: JSON.stringify(request),
                    contentType: "application/json; charset=utf-8",
